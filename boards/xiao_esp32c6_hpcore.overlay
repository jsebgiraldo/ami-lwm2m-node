/*
 * Devicetree overlay for XIAO ESP32-C6 + Seeed RS485 Expansion Board
 *
 * Seeed RS485 Expansion Board wiring (per Seeed wiki & TP8485E transceiver):
 *   D4 (GPIO22) = TX  (MCU → transceiver DI → RS485 bus)
 *   D5 (GPIO23) = RX  (RS485 bus → transceiver RO → MCU)
 *   D2 (GPIO2)  = DE/RE  (HIGH = transmit, LOW = receive)
 *
 * We configure UART1 on GPIO22(TX)/GPIO23(RX) for DLMS/COSEM serial
 * communication with the Microstar smart meter.
 *
 * Note: GPIO22/GPIO23 are shared with I2C0 — I2C is disabled here.
 */

#include <zephyr/dt-bindings/pinctrl/esp-pinctrl-common.h>
#include <zephyr/dt-bindings/pinctrl/esp32c6-pinctrl.h>
#include <zephyr/dt-bindings/pinctrl/esp32c6-gpio-sigmap.h>

/* Add UART1 pin configuration */
&pinctrl {
	uart1_default: uart1_default {
		group1 {
			pinmux = <UART1_TX_GPIO22>;
			output-high;
		};

		group2 {
			pinmux = <UART1_RX_GPIO23>;
			bias-pull-up;
		};
	};
};

/* Disable I2C0 since GPIO22/23 are now used for UART1 (RS485) */
&i2c0 {
	status = "disabled";
};

/* Enable Timer-Group 0 hardware watchdog (v0.6.13+, PRIO 9).
 * Last-resort defense against firmware hangs that the soft watchdog
 * cannot recover from (system_workq stuck, scheduler stalled, USB
 * drain blocked at sys_reboot). Driven via Zephyr's task_wdt subsystem
 * — see src/hw_watchdog.c. */
&wdt0 {
	status = "okay";
};

/* Enable on-die temperature sensor (v0.6.11+).
 * Used to monitor SoC self-heating during operation. Read via
 * sensor_sample_fetch + sensor_channel_get(SENSOR_CHAN_DIE_TEMP).
 * Range: -40°C to +125°C. Accuracy ~±2°C after factory calibration. */
&coretemp {
	status = "okay";
};

/* v0.6.34: drop CPU clock 160 -> 80 MHz to cut self-heating.
 * Field die temps measured avg 71C / max 82C (17/30 nodes >70C) with the
 * always-on (rx-on MED) radio + 160 MHz CPU. Halving the CPU clock lowers
 * CPU dynamic power without touching the radio duty cycle, so the node stays
 * always-attached and fully reachable (RPC/OTA latency unchanged) — unlike a
 * sleepy (SED/CSL) conversion. The esp32 clock driver reads this property at
 * init and calls rtc_clk_cpu_freq_set_config (drivers/clock_control/
 * clock_control_esp32.c:883,762-770), so this actually reprograms the PLL.
 * NOTE: rgb_led.c WS2812 bit-bang timing is cycle-count based and is kept in
 * sync via CPU_FREQ_MHZ=80 there. 80 MHz is a valid C6 CPU freq (80/120/160). */
&cpu0 {
	clock-frequency = <80000000>;
};

/* Enable UART1 for RS485 DLMS communication */
&uart1 {
	status = "okay";
	current-speed = <9600>;
	pinctrl-0 = <&uart1_default>;
	pinctrl-names = "default";
};

/* RS485 DE/RE control pin — defined as a GPIO node */
/ {
	rs485_ctrl: rs485_ctrl {
		compatible = "gpio-leds";  /* Reuse gpio-leds compatible for simple GPIO */
		rs485_de: rs485_de {
			gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
			label = "RS485 DE/RE";
		};
	};

	aliases {
		rs485-uart = &uart1;
	};
};
