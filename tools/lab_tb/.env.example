# tools/lab_tb/.env.example — copy to tools/lab_tb/.env to override defaults.
#
# docker compose auto-loads ".env" from the directory holding docker-compose.yml.
# EVERY value below already has a working default baked into docker-compose.yml,
# so the stack runs with NO .env at all. Copy this file only to deviate.
#
#   cp tools/lab_tb/.env.example tools/lab_tb/.env

# --- Images ----------------------------------------------------------------
# tb-node:4.3.1.3 is already present in WSL (2.32 GB) — keep the tag pinned so a
# `docker compose pull` never silently drags in a new major.
TB_IMAGE=thingsboard/tb-node:4.3.1.3
# postgres:18 is what thingsboard.io pairs with 4.3.x. Note the 18 image keeps
# PGDATA under /var/lib/postgresql/18/docker, which is why the volume mounts
# /var/lib/postgresql (NOT /var/lib/postgresql/data as on <=16).
TB_PG_IMAGE=postgres:18

# --- Ports (host networking: these bind directly in WSL's namespace) --------
# 8080 = web UI + REST. Reachable from Windows at http://localhost:8080 thanks to
# WSL2 localhostForwarding. Change only if something else in WSL owns 8080.
TB_HTTP_PORT=8080
# 5683 = LwM2M NoSec. DO NOT change unless you also change the SRP SRV record
# AND accept that the firmware's Strategy-2 discovery fallback hardcodes 5683.
TB_LWM2M_PORT=5683
TB_LWM2M_DTLS_PORT=5684
TB_PG_PORT=5432

# --- Credentials -----------------------------------------------------------
# Postgres only. The TB tenant login is fixed by LOAD_DEMO=true at install time:
#   tenant@thingsboard.org / tenant      (what tools/fleet_common.py expects)
#   sysadmin@thingsboard.org / sysadmin
TB_PG_PASSWORD=postgres

# --- Sizing ----------------------------------------------------------------
# Check WSL's ceiling first: wsl -d Ubuntu-24.04 -- free -m
# Keep Xmx below ~60% of WSL's total RAM or the JVM and postgres will fight.
TB_JAVA_XMS=512m
TB_JAVA_XMX=2048m

# --- Behaviour -------------------------------------------------------------
# Seconds of silence before TB marks a device inactive (TB default 600).
TB_INACTIVITY_TIMEOUT_S=1200
