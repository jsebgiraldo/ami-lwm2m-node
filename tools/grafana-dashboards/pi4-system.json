{
  "annotations": {"list": []},
  "title": "AMI - Pi4 Edge System",
  "uid": "ami-pi4",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "panels": [
    {"id": 1, "title": "CPU usage %", "type": "timeseries",
     "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "percent", "max": 100, "min": 0}}},
    {"id": 2, "title": "Memory used %", "type": "timeseries",
     "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "percent", "max": 100, "min": 0}}},
    {"id": 3, "title": "Load average", "type": "timeseries",
     "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [
       {"expr": "node_load1", "refId": "A", "legendFormat": "1m"},
       {"expr": "node_load5", "refId": "B", "legendFormat": "5m"},
       {"expr": "node_load15", "refId": "C", "legendFormat": "15m"}]},
    {"id": 4, "title": "Disk used %", "type": "timeseries",
     "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "100 - 100 * node_filesystem_avail_bytes{mountpoint=\"/host\",fstype!=\"tmpfs\"} / node_filesystem_size_bytes{mountpoint=\"/host\",fstype!=\"tmpfs\"}", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "percent", "max": 100, "min": 0}}},
    {"id": 5, "title": "Net RX rate", "type": "timeseries",
     "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "rate(node_network_receive_bytes_total{device!~\"lo|veth.*|docker.*|br-.*\"}[1m])", "refId": "A", "legendFormat": "{{device}}"}],
     "fieldConfig": {"defaults": {"unit": "Bps"}}},
    {"id": 6, "title": "Net TX rate", "type": "timeseries",
     "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|docker.*|br-.*\"}[1m])", "refId": "A", "legendFormat": "{{device}}"}],
     "fieldConfig": {"defaults": {"unit": "Bps"}}}
  ]
}
