{
  "annotations": {"list": []},
  "title": "AMI - Thread Mesh State",
  "uid": "ami-mesh",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "panels": [
    {"id": 1, "title": "Routers attached", "type": "stat",
     "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "otbr_routers_total", "refId": "A"}],
     "fieldConfig": {"defaults": {"color": {"mode": "thresholds"},
       "thresholds": {"mode": "absolute", "steps": [
         {"value": null, "color": "red"},
         {"value": 1, "color": "yellow"},
         {"value": 5, "color": "green"}]}}}},
    {"id": 2, "title": "Direct neighbors", "type": "stat",
     "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "otbr_neighbors_total", "refId": "A"}]},
    {"id": 3, "title": "Leader status", "type": "stat",
     "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "otbr_role_leader", "refId": "A"}],
     "fieldConfig": {"defaults": {"mappings": [
       {"type": "value", "options": {"1": {"text": "LEADER"}, "0": {"text": "OTHER"}}}]}}},
    {"id": 4, "title": "Partition ID", "type": "stat",
     "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "otbr_partition_id", "refId": "A"}]},
    {"id": 5, "title": "Router age (s) per router_id", "type": "timeseries",
     "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "otbr_router_age_s", "refId": "A", "legendFormat": "router {{router_id}}"}]},
    {"id": 6, "title": "Neighbor RSSI (dBm)", "type": "timeseries",
     "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "otbr_neighbor_rssi_dbm", "refId": "A", "legendFormat": "{{rloc16}}"}],
     "fieldConfig": {"defaults": {"unit": "dBm"}}},
    {"id": 7, "title": "MAC TX rate (frames/s)", "type": "timeseries",
     "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [
       {"expr": "rate(otbr_mac_tx_total[1m])", "refId": "A", "legendFormat": "TX total"},
       {"expr": "rate(otbr_mac_tx_acked[1m])", "refId": "B", "legendFormat": "TX ACKed"}]},
    {"id": 8, "title": "MAC RX rate (frames/s)", "type": "timeseries",
     "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "rate(otbr_mac_rx_total[1m])", "refId": "A", "legendFormat": "RX"}]}
  ]
}
