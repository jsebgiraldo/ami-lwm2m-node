        <mxCell id="55" value="&lt;b&gt;Step 5&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Rollout 6 USB&lt;br/&gt;&lt;br/&gt;Flash remaining nodes via flash_ota_migrate.py for-loop. Allow 30 min stabilization." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1320" y="1165" width="290" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="56" value="&lt;b&gt;Step 6&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Re-QA all 6&lt;br/&gt;&lt;br/&gt;Run board_acceptance.py --skip-flash on each. Target: ≥5/6 APTO PSU verdict. Update fleet_map.csv." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
