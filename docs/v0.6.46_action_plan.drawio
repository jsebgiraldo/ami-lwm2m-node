        <mxCell id="53" value="&lt;b&gt;Step 3&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;QA 30 min&lt;br/&gt;&lt;br/&gt;board_acceptance.py with --soak-seconds 1800&lt;br/&gt;&lt;br/&gt;Target: tr +0, recover +0, no serial flags." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="700" y="1165" width="290" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="54" value="&lt;b&gt;Step 4&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Add Layer 2+3&lt;br/&gt;&lt;br/&gt;Build v0.6.46-final with Kconfig defense + QA forensic upgrade. Flash 3 nodes, 1h soak each (sequential)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
