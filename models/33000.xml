<?xml version="1.0" encoding="UTF-8"?>
<LWM2M xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="http://www.openmobilealliance.org/tech/profiles/LWM2M-v1_1.xsd">
  <Object ObjectType="MODefinition">
    <Name>Thread MAC + LwM2M Diagnostics</Name>
    <Description1>Custom AMI object combining Thread MAC counters, LwM2M client observability counters, and boot-reliability state for un-fakeable watchdog telemetry.</Description1>
    <ObjectID>33000</ObjectID>
    <ObjectURN>urn:oma:lwm2m:x:33000:1.0</ObjectURN>
    <LWM2MVersion>1.1</LWM2MVersion>
    <ObjectVersion>1.0</ObjectVersion>
    <MultipleInstances>Single</MultipleInstances>
    <Mandatory>Optional</Mandatory>
    <Resources>
      <Item ID="0">
        <Name>Thread Role</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>String</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>Current Thread role: Disabled, Detached, Child, Router, or Leader.</Description>
      </Item>
      <Item ID="1">
        <Name>Partition ID</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>Thread partition identifier.</Description>
      </Item>
      <Item ID="2">
        <Name>TX Total</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>Total MAC frames transmitted.</Description>
      </Item>
      <Item ID="3">
        <Name>RX Total</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>Total MAC frames received.</Description>
      </Item>
      <Item ID="4">
        <Name>TX Unicast</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>Unicast MAC frames transmitted.</Description>
      </Item>
      <Item ID="5">
        <Name>RX Unicast</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>Unicast MAC frames received.</Description>
      </Item>
      <Item ID="6">
        <Name>TX Broadcast</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>Broadcast MAC frames transmitted.</Description>
      </Item>
      <Item ID="7">
        <Name>RX Broadcast</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>Broadcast MAC frames received.</Description>
      </Item>
      <Item ID="8">
        <Name>TX Error Abort</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>MAC transmissions aborted due to errors.</Description>
      </Item>
      <Item ID="9">
        <Name>RX Error No Frame</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>MAC RX errors with no frame received.</Description>
      </Item>
      <Item ID="10">
        <Name>Uptime</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units>s</Units>
        <Description>Seconds since boot.</Description>
      </Item>
      <Item ID="11">
        <Name>Reg Attempts</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>Total lwm2m_rd_client_start() calls.</Description>
      </Item>
      <Item ID="12">
        <Name>Reg Success</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>REGISTRATION_COMPLETE events.</Description>
      </Item>
      <Item ID="13">
        <Name>Notify Emitted</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>Cumulative notifications sent.</Description>
      </Item>
      <Item ID="14">
        <Name>Notify Throttled</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>Cumulative notifications throttled.</Description>
      </Item>
      <Item ID="15">
        <Name>Recover Count</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>lwm2m_recover_work invocations.</Description>
      </Item>
      <Item ID="16">
        <Name>Restart Success</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>REGISTRATION_COMPLETE after a recovery.</Description>
      </Item>
      <Item ID="17">
        <Name>Last Error Code</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>Last errno from rd_client_start, negative or 0.</Description>
      </Item>
      <Item ID="18">
        <Name>Last Error Uptime</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units>s</Units>
        <Description>Uptime in seconds when the last error was recorded.</Description>
      </Item>
      <Item ID="19">
        <Name>Watchdog Count</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>Times the silence watchdog forced a recover.</Description>
      </Item>
      <Item ID="20">
        <Name>Storm Backoff Applied</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>Times backoff was doubled due to 5.xx/timeout responses.</Description>
      </Item>
      <Item ID="21">
        <Name>Last Reset Reason</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>hwinfo_get_reset_cause() bitmap captured at boot; -1 if unavailable.</Description>
      </Item>
      <Item ID="22">
        <Name>Total Resets</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>Monotonic reset counter, persisted in NVS — un-fakeable proof of a watchdog-driven reboot.</Description>
      </Item>
      <Item ID="23">
        <Name>Hang Uptime</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units>s</Units>
        <Description>Uptime at the last snapshot before the previous reset.</Description>
      </Item>
      <Item ID="24">
        <Name>Hang Heap Free</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units>B</Units>
        <Description>Free heap bytes at that snapshot.</Description>
      </Item>
      <Item ID="25">
        <Name>Hang Heap Min Free</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units>B</Units>
        <Description>Lifetime minimum free heap up to that snapshot.</Description>
      </Item>
      <Item ID="26">
        <Name>Hang Reg Age</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units>s</Units>
        <Description>Seconds since the last REG_UPDATE_COMPLETE at that snapshot.</Description>
      </Item>
      <Item ID="27">
        <Name>Hang LwM2M State</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>Bitmap: 0x01 started, 0x02 registered, 0x04 observing, 0x08 recovering, 0x80 last_error set.</Description>
      </Item>
      <Item ID="28">
        <Name>Hang Thread Role</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>OpenThread role at that snapshot: 0 disabled, 1 detached, 2 child, 3 router, 4 leader.</Description>
      </Item>
      <Item ID="29">
        <Name>Keepalive Emit Count</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>Heartbeats emitted; the silence watchdog's liveness signal.</Description>
      </Item>
      <Item ID="30">
        <Name>Keepalive Consec Fail</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>Consecutive keepalive failures the engine is otherwise hiding.</Description>
      </Item>
      <Item ID="31">
        <Name>Last Emit Uptime</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units>s</Units>
        <Description>Uptime when the watchdog last saw a sign of life.</Description>
      </Item>
      <Item ID="32">
        <Name>NoReg Boots</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>Consecutive boots that never reached a first REGISTER.</Description>
      </Item>
      <Item ID="33">
        <Name>In Recovery</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>1 while recover_work_fn is running, else 0.</Description>
      </Item>
      <Item ID="34">
        <Name>Boot Burst</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>Consecutive unstable boots; 0 = healthy. Alarm as it approaches CONFIG_AMI_BOOT_BURST_MAX.</Description>
      </Item>
      <Item ID="35">
        <Name>Detached Total</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units>s</Units>
        <Description>Cumulative seconds spent detached from the mesh.</Description>
      </Item>
      <Item ID="36">
        <Name>Heap Min Free Live</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units>B</Units>
        <Description>Live lifetime minimum free heap for this boot.</Description>
      </Item>
      <Item ID="37">
        <Name>Last Reboot Code</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>Reboot path that caused this boot: 1-10 planned recovery paths, 11 kernel panic, 12-15 hardware-watchdog paths, 16 OTA apply, 99 unknown, 0 = did not pass through firmware (power-on, brownout or external reset).</Description>
      </Item>
      <Item ID="38">
        <Name>LwM2M TX Bytes</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units>B</Units>
        <Description>Exact cumulative LwM2M/CoAP bytes put on the wire since boot, counted at the engine send chokepoint. Server computes bytes/min as a delta and avg packet size as tx_bytes_delta / notify_emitted_delta.</Description>
      </Item>
      <Item ID="39">
        <Name>Panic Reason</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>K_ERR_* code passed to k_sys_fatal_error_handler; 0 = no panic.</Description>
      </Item>
      <Item ID="40">
        <Name>Panic MEPC</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>Address of the faulting instruction.</Description>
      </Item>
      <Item ID="41">
        <Name>Panic RA</Name>
        <Operations>R</Operations>
        <MultipleInstances>Single</MultipleInstances>
        <Mandatory>Mandatory</Mandatory>
        <Type>Integer</Type>
        <RangeEnumeration></RangeEnumeration>
        <Units></Units>
        <Description>Return address at the fault — one caller frame up from MEPC.</Description>
      </Item>
    </Resources>
    <Description2/>
  </Object>
</LWM2M>
